{
  "name": "scad-ai-ide-builder",
  "version": "0.1.0",
  "description": "Build and development tooling for SCAD AI IDE",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Peter",
    "email": "peterisdev@proton.me",
    "url": "https://github.com/peterisdev42"
  },
  "scripts": {
    "prepare:vscode": "bash scripts/prepare-vscode.sh",
    "dev:vscode": "bash scripts/dev-vscode.sh",
    "dev:vscode:fresh": "bash scripts/dev-vscode.sh --fresh",
    "reset:vscode": "node scripts/reset-vscode.mjs",
    "dev:vscode:reset": "npm run reset:vscode && npm run dev:vscode",
    "watch:vscode": "cd sources/vscode && npm run watch",
    "build:extensions": "bash scripts/build-extensions.sh",
    "stage:extensions": "bash scripts/stage-extensions.sh .dev/stage/extensions",
    "preview:sync": "npm --prefix sources/scad-ai-ide run preview:sync --",
    "test:preview-sync": "npm --prefix sources/scad-ai-ide run test:preview-sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterisdev42/scad-ai-ide-builder.git"
  },
  "bugs": {
    "url": "https://github.com/peterisdev42/scad-ai-ide-builder/issues"
  },
  "homepage": "https://github.com/peterisdev42/scad-ai-ide-builder#readme",
  "volta": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
